  steps:
  - actionType: 1
    targetUI_ID: {fileID: 0}
    dialogueText: "\uD310\uD0C0\uC9C0 \uD0A4\uC6B0\uAE30\uC5D0 \uC624\uC2E0 \uAC83\uC744
      \uD658\uC601\uD569\uB2C8\uB2E4!!!"
    arrowDir: 0
    useCustomPosition: 1
    customDialogueAnchoredPosition: {x: 0, y: 800}
    customDialogueSize: {x: 1000, y: 500}
    customArrowAnchoredPosition: {x: 510, y: -900}
    customArrowSize: {x: 100, y: 100}
  - actionType: 1
    targetUI_ID: {fileID: 0}
    dialogueText: "\uC2DC\uC791 \uC804 \uAE30\uBCF8\uC801\uC778 \uAE30\uB2A5\uB4E4\uC744
      \uBA3C\uC800 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
    arrowDir: 0
    useCustomPosition: 1
    customDialogueAnchoredPosition: {x: 0, y: 800}
    customDialogueSize: {x: 1000, y: 500}
    customArrowAnchoredPosition: {x: 510, y: -900}
    customArrowSize: {x: 100, y: 100}
  - actionType: 0
    targetUI_ID: {fileID: 11400000, guid: 9956583c5399113419acb905ff21d8ff, type: 2}
    dialogueText: "\uC0C1\uC810 : \uACE8\uB4DC\uB97C \uC0AC\uC6A9\uD574 \uBB34\uAE30\uC640
      \uC7AC\uB8CC\uB97C \uAD6C\uC785\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
    arrowDir: 0
    useCustomPosition: 1
    customDialogueAnchoredPosition: {x: 0, y: -800}
    customDialogueSize: {x: 1000, y: 500}
    customArrowAnchoredPosition: {x: 510, y: -900}
    customArrowSize: {x: 100, y: 100}
  - actionType: 1
    targetUI_ID: {fileID: 11400000, guid: 13f0d4d257eb64c42b52bfb38f0f4a15, type: 2}
    dialogueText: "\uC2A4\uD0AC : \uC2A4\uD0AC\uC744 \uCC0D\uACE0 \uC7A5\uCC29\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
    arrowDir: 0
    useCustomPosition: 1
    customDialogueAnchoredPosition: {x: 0, y: -800}
    customDialogueSize: {x: 1000, y: 500}
    customArrowAnchoredPosition: {x: 510, y: -900}
    customArrowSize: {x: 100, y: 100}
  - actionType: 1
    targetUI_ID: {fileID: 11400000, guid: c8c32e745e06df046870ace38b7ebfb7, type: 2}
    dialogueText: "\uC804\uD22C : \uCE90\uB9AD\uD130\uAC00 \uC2F8\uC6B0\uB294 \uC804\uC7A5\uC785\uB2C8\uB2E4!"
    arrowDir: 0
    useCustomPosition: 1
    customDialogueAnchoredPosition: {x: 0, y: -800}
    customDialogueSize: {x: 1000, y: 500}
    customArrowAnchoredPosition: {x: 510, y: -900}
    customArrowSize: {x: 100, y: 100}
  - actionType: 1
    targetUI_ID: {fileID: 11400000, guid: 8bfe84e7b50b64d4a801575b66ff594d, type: 2}
    dialogueText: "\uC7A5\uBE44 : \uC7A5\uBE44\uB97C \uC7A5\uCC29, \uAC15\uD654,
      \uD569\uC131, \uAC01\uC131\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
    arrowDir: 0
    useCustomPosition: 1
    customDialogueAnchoredPosition: {x: 0, y: -800}
    customDialogueSize: {x: 1000, y: 500}
    customArrowAnchoredPosition: {x: 510, y: -900}
    customArrowSize: {x: 100, y: 100}
  - actionType: 1
    targetUI_ID: {fileID: 11400000, guid: cd1eaac682edf4543b792bd2a1925348, type: 2}
    dialogueText: "\uB358\uC804 : \uB2E4\uC591\uD55C \uB358\uC804\uC5D0\uC11C \uAC01\uC885
      \uD76C\uADC0\uD55C \uC7AC\uB8CC\uB97C \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
